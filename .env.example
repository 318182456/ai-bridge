PORT=18861
BIND_ADDRESS=0.0.0.0
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
API_KEY=replace-with-a-different-long-random-api-key
TASK_TIMEOUT_SECONDS=180
QUEUE_LIMIT=32
TRAEFIK_SUBDOMAIN=agy-docker
TRAEFIK_CONTAINER_PORT=18861
MAX_CONCURRENCY=1
SESSION_LIMIT=2
SESSION_IDLE_SECONDS=120
SESSION_MAX_TURNS=50
IMAGE_TAG=0.4.0-alpha.13
DATA_PATH=/volume1/docker/agy-data

# agy / robin / aist / auto; changing this does not replay failed calls
DEFAULT_BACKEND=agy

# Total live Chromium profiles, shared by login and generation
MAX_BROWSER_CONTEXTS=2

# PostgreSQL mode; migrate existing local data before enabling on an existing install
# DATABASE_URL=postgresql://USER:PASSWORD@postgresql:5432/ai_bridge
